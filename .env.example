# ==============================================================================
# SAFDAR KHAN PORTFOLIO — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these keys
# in your Vercel Project Settings -> Environment Variables.
# NEVER commit `.env.local` or real API keys to GitHub.

# 1. Canonical Production Domain URL (used for Sitemap, Robots.txt, JSON-LD & Open Graph)
# Examples: https://safdarkhan.com | https://safdarkhan.dev | https://safdarkhan.tech
NEXT_PUBLIC_SITE_URL=https://safdarkhan.dev

# 2. Optional Email Delivery Integration for /api/contact (Resend API)
# Leave blank if not yet configured — the Contact Form automatically provides
# instant pre-filled WhatsApp (+92 331 6788362) and Email Client (mailto:) fallbacks.
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=
CONTACT_SENDER_EMAIL="Safdar Khan Portfolio <onboarding@resend.dev>"
